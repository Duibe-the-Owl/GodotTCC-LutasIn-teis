[node name="RichTextLabel" type="RichTextLabel" parent="MainMenu/AboutWindow/VBoxContainer" unique_id=1630164692]
layout_mode = 2
theme_override_fonts/normal_font = ExtResource("4_uyity")
theme_override_font_sizes/normal_font_size = 25
text = "Este projeto de conclusão de curso se apresenta como uma articulação de uma junta filosófica enraizada fortemente no pensamento absurdista de Albert Camus e seu Mito de Sísifo, com uma segunda junta narrativa interativa-visual que se desdobra e permite seu movimento completo. Lutas Inúteis é um olhar para dentro de um mundo sem aparente sentido e um olhar para dentro de si próprio."
fit_content = true

